// Cloudflare settings for Audio City Life.
// The game page is served free from the dist folder; live chat runs in the Durable Object in cloudflare/worker.mjs.
{
  "name": "audio-city-life",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "build": { "command": "sh cloudflare/build.sh" },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "Live" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Live"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "acl-config", "database_id": "5aed4425-400b-413f-8113-79b700b95284" }],
  "observability": { "enabled": true }
}
